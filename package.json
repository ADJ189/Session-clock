{
  "name": "session-clock",
  "version": "2.0.0",
  "description": "Beautiful animated clock — 101+ themes, Pomodoro, ambient sound, literary clock, focus log.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "deno run -A npm:vite@6.4.4",
    "build": "deno run -A npm:typescript@7.0.2/tsc --noEmit && deno run -A npm:vite@6.4.4 build",
    "preview": "deno run -A npm:vite@6.4.4 preview",
    "typecheck": "deno run -A npm:typescript@7.0.2/tsc --noEmit",
    "lint": "deno run -A npm:oxlint@1.89.0 .",
    "lint:fix": "deno run -A npm:oxlint@1.89.0 . --fix",
    "typecheck:e2e": "deno run -A npm:typescript@7.0.2/tsc -p tests/tsconfig.json",
    "test:unit": "deno test -A --sloppy-imports tests-deno",
    "test:e2e": "deno run -A npm:@playwright/test@1.64.1/cli test",
    "test:e2e:mobile": "deno run -A npm:@playwright/test@1.64.1/cli test --config=playwright.mobile.config.ts",
    "test:e2e:ui": "deno run -A npm:@playwright/test@1.64.1/cli test --ui",
    "test:e2e:headed": "deno run -A npm:@playwright/test@1.64.1/cli test --headed",
    "test:e2e:chromium": "deno run -A npm:@playwright/test@1.64.1/cli test --project=desktop-chromium",
    "test:e2e:firefox": "deno run -A npm:@playwright/test@1.64.1/cli test --project=desktop-firefox",
    "test:e2e:webkit": "deno run -A npm:@playwright/test@1.64.1/cli test --project=desktop-webkit",
    "test:e2e:report": "deno run -A npm:@playwright/test@1.64.1/cli show-report",
    "e2e:install": "deno run -A npm:@playwright/test@1.64.1/cli install",
    "previews": "deno run -A --sloppy-imports scripts/gen-theme-previews.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.4"
  },
  "dependencies": {
    "animejs": "^4.5.0"
  }
}
